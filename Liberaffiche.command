#!/bin/bash
# Libéraffiche pour macOS - fichier unique et autonome.
# Double-clic : installe Liberaffiche.app dans ~/Applications puis la lance.
# (L'application est embarquée à la fin de ce fichier.)

SELF="$0"
DEST="$HOME/Applications"
APP="$DEST/Liberaffiche.app"

echo "Installation de Libéraffiche dans $DEST ..."
mkdir -p "$DEST" || exit 1
rm -rf "$APP"
sed '1,/^__PAYLOAD__$/d' "$SELF" | base64 --decode | tar -xzf - -C "$DEST" || { echo "Échec de l'extraction."; exit 1; }
chmod +x "$APP/Contents/MacOS/Liberaffiche"
xattr -cr "$APP" 2>/dev/null   # retire la quarantaine : plus de blocage Gatekeeper sur l'app installée

echo "Lancement..."
open "$APP"

# Ferme la fenêtre Terminal ouverte par le double-clic
osascript -e 'tell application "Terminal" to close (every window whose name contains "Liberaffiche")' >/dev/null 2>&1 &
exit 0
